; Engine configuration file.

config_version=5

[application]

config/name="Slipstream"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/autoload/game.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[gui]

theme/custom_font="res://assets/fonts/BarlowSemiCondensed-Medium.ttf"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=4
common/physics_interpolation=true
jolt_physics_3d/limits/world_boundary_shape_size=20000.0

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

[shader_globals]

wx_wet={
"type": "float",
"value": 0.0
}
wx_wet_line={
"type": "float",
"value": 0.0
}
wx_snow={
"type": "float",
"value": 0.0
}
wx_rain={
"type": "float",
"value": 0.0
}
wx_wind={
"type": "float",
"value": 0.0
}

[editor]

movie_writer/mjpeg_quality=0.95
